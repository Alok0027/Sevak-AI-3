# Copy this file to .env and fill in real values when you have them.
# Until then, the app runs entirely on mocks (USE_MOCKS=true) with zero external calls.

# --- Mode switch -------------------------------------------------------
# false = use the real WhatsApp Business API below. Speech-to-text (STT_PROVIDER)
# and the LLM (LLM_PROVIDER) each have their own independent switch further down,
# so you can turn on a real LLM key without needing WhatsApp credentials too.
USE_MOCKS=true

# --- Database ------------------------------------------------------------
# Local dev default is SQLite (zero setup). Point this at Postgres when ready:
# DATABASE_URL=postgresql+psycopg2://sevakai:sevakai@localhost:5432/sevakai
DATABASE_URL=sqlite:///./sevakai_dev.db

# --- Auth ------------------------------------------------------------
JWT_SECRET=change-me-before-any-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Encryption at rest (NFR-SC1) -------------------------------------
# AES-256 key protecting patient name/phone and visit transcript/structured
# data (see app/core/encryption.py). Generate your own per environment:
#   python scripts/generate_encryption_key.py
# Then run scripts/encrypt_existing_data.py once to backfill any data
# already in the DB. Losing this key makes encrypted rows unrecoverable --
# treat .env as a secret and back it up before rotating.
ENCRYPTION_KEY=

# --- Speech-to-text provider ------------------------------------------
# mock = deterministic text-in/text-out (default, zero setup)
# whisper = real recognition via a local, self-hosted Whisper model --
#   no API key needed; use this while Bhashini access is pending.
# bhashini = real ULCA API call, needs the BHASHINI_* keys below.
STT_PROVIDER=mock
WHISPER_MODEL_SIZE=small        # tiny/base/small/medium/large-v3 -- bigger = more accurate, slower

# --- Bhashini (speech-to-text) --------------------------------------
# Register at bhashini.gov.in/ulca to get these. Only needed when STT_PROVIDER=bhashini.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_BASE_URL=https://meity-auth.ulcacontrib.org

# --- LLM (Agent 1 clinical NER, Agent 2 risk reasoning, Agent 3/4 drafting) --
# Any OpenAI-compatible endpoint works (OpenAI, Groq, etc). Independent of
# USE_MOCKS -- flipping this on does NOT also switch WhatsApp to the real
# Graph API, so you don't need WhatsApp credentials just to test an LLM key.
LLM_PROVIDER=mock              # mock (default) | real
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
# Free/no-credit-card example -- Groq (OpenAI-compatible):
#   LLM_PROVIDER=real
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=openai/gpt-oss-120b   # Groq's model IDs change -- see console.groq.com/docs/models if this 404s
#   LLM_BASE_URL=https://api.groq.com/openai/v1

# --- WhatsApp ---------------------------------------------------------
# mock (default) | meta | twilio_sandbox
#
# meta           = the real WhatsApp Business API, which needs Meta
#                  approval and uses the two values below.
# twilio_sandbox = Twilio's WhatsApp sandbox. No Meta approval, and it
#                  works on a free Twilio trial -- the only way to deliver
#                  Agent 3's real free-form Hindi message without a paid
#                  or approved account. Reuses the TWILIO_* values below
#                  and needs nothing here. Each recipient must first send
#                  "join <your-code>" to +1 415 523 8886 (find the code in
#                  Twilio Console -> Messaging -> Try it out -> WhatsApp),
#                  and their session lapses after three days.
WHATSAPP_PROVIDER=mock
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- SMS (Twilio) -- real delivery channel without WhatsApp API access --
# Independent of USE_MOCKS/WhatsApp, same reasoning as LLM_PROVIDER above.
# Get these from console.twilio.com: Account SID is on the dashboard home;
# API Key SID/Secret from Account -> API keys & tokens -> Create API key
# (Standard type is simplest -- Restricted needs Messaging: Message
# Create+Read permissions specifically); phone number from Phone Numbers ->
# Manage -> Active Numbers (trial accounts get one free). The same three
# credentials also drive WHATSAPP_PROVIDER=twilio_sandbox above, which
# needs no phone number of its own.
#
# Note for India: Twilio reaches Indian numbers over an international
# route that replaces the sender ID with a random short code, so SMS is
# one-way -- patients cannot reply. A branded two-way sender ID requires
# DLT registration with the Indian operators. WhatsApp has no such limit.
SMS_PROVIDER=mock              # mock (default) | real
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=

# --- Misc ------------------------------------------------------------
ENVIRONMENT=development

# --- WhatsApp Cloud API (WHATSAPP_PROVIDER=meta) -----------------------
# Everything except the token is a public identifier, all from the app's
# WhatsApp > API Setup page. The token is the only secret here.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# The approved template Agent 3 sends. A follow-up reminder is
# business-initiated, so free-form text is refused (131047) -- only an
# approved template is delivered. Create it with
# scripts/create_whatsapp_template.py, which declares its three blanks in
# the order Agent 3 fills them.
WHATSAPP_TEMPLATE_NAME=followup_reminder
WHATSAPP_TEMPLATE_LANGUAGE=hi

# --- Twilio WhatsApp sandbox (WHATSAPP_PROVIDER=twilio_sandbox) --------
# Twilio's shared sandbox sender; the same for every account.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Deployment-only settings ----------------------------------------
# Browser origins allowed to call this API, comma-separated. "*" is a
# development convenience; set it to the deployed dashboard's origin (no
# trailing slash) on anything public:
#   CORS_ORIGINS=https://sevakai.vercel.app
CORS_ORIGINS=*

# Create the SRS section 9 demo accounts at startup if absent. A freshly
# provisioned Postgres has no one to log in as. Idempotent; leave false
# locally, where scripts/seed_synthetic_data.py does the same job on demand.
SEED_DEMO_ON_START=false
