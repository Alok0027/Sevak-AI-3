<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.

         It is also declared in src/main so that release builds have it too.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug only. The dev backend is plain http on the LAN
         (http://192.168.x.x:8000), and Android blocks cleartext by default
         from targetSdk 28 onward; this app targets 36. Scoping the opt-out
         to the debug manifest means local development keeps working while a
         release APK still refuses unencrypted connections, which is what you
         want for an app carrying patient names and transcripts.

         No tools:replace needed: merging adds this attribute to the
         application element rather than overwriting one, because src/main
         does not set it.
    -->
    <application android:usesCleartextTraffic="true" />
</manifest>
