<?xml version="1.0" encoding="utf-8"?>
<!-- What the phone shows between tapping the icon and Flutter's first
     frame. A blank white rectangle reads as a hung app on the cheap
     handsets these workers actually carry, where that gap runs over a
     second; the emblem tells her it is starting. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_emblem" />
    </item>
</layer-list>
